"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3014         put weighted_score @;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3015         put chosen_flag @;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3016         put optmodel_score @;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3017         put optmodel_travel @;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3018         put optmodel_value ;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3019         ;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3020       end;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3021      if _ERROR_ then call symputx('_EFIERR_',1);  /* set ERROR detection macro variable */\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3022      if EFIEOD then call symputx('_EFIREC_',EFIOUT);\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3023      run;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: The file '/workspaces/myfolder/OperationNextNest/Data/onn_result_Base.csv' is:\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      Filename=/workspaces/myfolder/OperationNextNest/Data/onn_result_Base.csv,\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      Owner Name=sas,Group Name=sas,\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      Access Permission=-rw-r--r--,\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      Last Modified=06Apr2026:16:12:30\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: 717 records were written to the file '/workspaces/myfolder/OperationNextNest/Data/onn_result_Base.csv'.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      The minimum record length was 369.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      The maximum record length was 1120.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: There were 716 observations read from the data set WORK.ONN_RESULT_BASE.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: DATA statement used (Total process time):\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      real time           0.03 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      cpu time            0.03 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      \",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"716 records created in /workspaces/myfolder/OperationNextNest/Data/onn_result_Base.csv from WORK.ONN_RESULT_BASE.\",\n\t\t\"type\": \"normal\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"  \",\n\t\t\"type\": \"normal\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"  \",\n\t\t\"type\": \"normal\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: \\\"/workspaces/myfolder/OperationNextNest/Data/onn_result_Base.csv\\\" file was successfully created.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: PROCEDURE EXPORT used (Total process time):\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      real time           0.05 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      cpu time            0.06 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      \",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3024  ;*';*\\\";*/;run;quit;ods html5(id=vscode) close;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"3025  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t}\n]","mime":"application/vnd.sas.compute.log.lines"}]}]},{"kind":1,"language":"markdown","value":"***\n\n### **Step 5 | Try Different “What Matters Most?” Scenarios**\n\nOne of the most important ideas in this project is that different households may value different things.\n\nSome may prioritize a shorter commute.  \nOthers may care more about affordability, family-oriented neighborhoods, or access to amenities.\n\nOur scoring framework should reflect that.\n\nTo explore this idea, we will run several **scenario-based neighborhood comparisons** using different weighting schemes.\n\n| Scenario | Main Emphasis |\n|---------|----------------|\n| Base | Balanced priorities |\n| CommuteFirst | Shorter commute |\n| KidFriendly | Family-oriented neighborhoods |\n| AmenityHeavy | Parks, groceries, and bike access |\n\nEach scenario uses the same underlying neighborhood data, but changes the **weights** in the scoring formula.\n\nThese weights represent what matters most in that scenario, and in each case they add up to **1.0**.\n\n`PROC OPTMODEL` then identifies the **Top 10 candidate neighborhoods** that best match those priorities while still respecting the scenario limits.\n\nAfter each scenario runs, we save the results to a scenario-specific dataset and CSV file.\n\nThese outputs will allow us to:\n\n- compare how the recommended neighborhoods change across scenarios\n- carry the results into **Part 3 (R)** for mapping and visual comparison\n\nNow let’s run the neighborhood comparison framework several different ways and see how the results change.","outputs":[]},{"kind":2,"language":"sas","value":"/*--------------------------------------------------------------*\n | Step 5 | Run additional scenario-based neighborhood\n |          comparisons\n |\n | Each scenario uses a different set of weights to represent\n | a different household priority structure.\n |\n | By comparing results across scenarios, we can see how the\n | recommended neighborhoods change when what matters most\n | changes.\n *--------------------------------------------------------------*/\n\n/*--------------------------------------------------------------*\n | Scenario 1 | CommuteFirst\n |\n | Heavier weight on commute time and a tighter maximum\n | travel-time limit.\n *--------------------------------------------------------------*/\n%run_scenario(\n    scen_name=CommuteFirst,\n    n_choice=10,\n    max_travel=25,\n    max_value=900000,\n    w_commute=0.45,\n    w_kids=0.20,\n    w_housing=0.15,\n    w_income=0.10,\n    w_amenities=0.10\n);\n\n/*--------------------------------------------------------------*\n | Scenario 2 | KidFriendly\n |\n | Greater emphasis on neighborhoods with stronger\n | family-oriented characteristics.\n *--------------------------------------------------------------*/\n%run_scenario(\n    scen_name=KidFriendly,\n    n_choice=10,\n    max_travel=30,\n    max_value=900000,\n    w_commute=0.20,\n    w_kids=0.40,\n    w_housing=0.15,\n    w_income=0.10,\n    w_amenities=0.15\n);\n\n/*--------------------------------------------------------------*\n | Scenario 3 | AmenityHeavy\n |\n | Greater emphasis on access to parks, grocery stores,\n | and bike trails.\n *--------------------------------------------------------------*/\n%run_scenario(\n    scen_name=AmenityHeavy,\n    n_choice=10,\n    max_travel=30,\n    max_value=900000,\n    w_commute=0.20,\n    w_kids=0.20,\n    w_housing=0.15,\n    w_income=0.10,\n    w_amenities=0.35\n);","outputs":[{"items":[{"data":"<!DOCTYPE html>\n<html lang=\"en\" xml:lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"SAS V.04.00\" name=\"generator\"/>\n<title>SAS Output</title>\n<style>\n/*<![CDATA[*/\n.body.c > table, .body.c > pre, .body.c div > table,\n.body.c div > pre, .body.c > table, .body.c > pre,\n.body.j > table, .body.j > pre, .body.j div > table,\n.body.j div > pre, .body.j > table, .body.j > pre,\n.body.c p.note, .body.c p.warning, .body.c p.error, .body.c p.fatal,\n.body.j p.note, .body.j p.warning, .body.j p.error, .body.j p.fatal,\n.body.c > table.layoutcontainer, .body.j > table.layoutcontainer { margin-left: auto; margin-right: auto }\n.layoutregion.l table, .layoutregion.l pre, .layoutregion.l p.note,\n.layoutregion.l p.warning, .layoutregion.l p.error, .layoutregion.l p.fatal { margin-left: 0 }\n.layoutregion.c table, .layoutregion.c pre, .layoutregion.c p.note,\n.layoutregion.c p.warning, .layoutregion.c p.error, .layoutregion.c p.fatal { margin-left: auto; margin-right: auto }\n.layoutregion.r table, .layoutregion.r pre, .layoutregion.r p.note,\n.layoutregion.r table, .layoutregion.r pre, .layoutregion.r p.note,\n.layoutregion.r p.warning, .layoutregion.r p.error, .layoutregion.r p.fatal { margin-right: 0 }\narticle, aside, details, figcaption, figure, footer, header, hgroup, nav, section { display: block }\nhtml{ font-size: 100% }\n.body { margin: 1em; font-size: 13px; line-height: 1.231 }\nsup { position: relative; vertical-align: baseline; bottom: 0.25em; font-size: 0.8em }\nsub { position: relative; vertical-align: baseline; top: 0.25em; font-size: 0.8em }\nul, ol { margin: 1em 0; padding: 0 0 0 40px }\ndd { margin: 0 0 0 40px }\nnav ul, nav ol { list-style: none; list-style-image: none; margin: 0; padding: 0 }\nimg { border: 0; vertical-align: middle }\nsvg:not(:root) { overflow: hidden }\nfigure { margin: 0 }\ntable { border-collapse: collapse; border-spacing: 0 }\n.layoutcontainer { border-collapse: separate; border-spacing: 0 }\np { margin-top: 0; text-align: left }\nh1