ource\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2495      /* More nearby amenities is better */\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2496      amenity_score = amenity_count_std;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2497  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2498  run;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: There were 716 observations read from the data set WORK.ONN_SCORES.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: The data set WORK.ONN_SCORES has 716 observations and 62 variables.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: DATA statement used (Total process time):\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      real time           0.00 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      cpu time            0.01 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      \",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2499  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2500  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2501  /*--------------------------------------------------------------*\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2502   | Step 3f | Review the scoring dataset\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2503   |\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2504   | These quick checks help confirm that the scoring components\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2505   | look reasonable before we move into the decision comparison\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2506   | stage using PROC OPTMODEL.\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2507   *--------------------------------------------------------------*/\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2508  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2509  title \\\"Preview of neighborhoods with scoring components\\\";\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2510  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2511  proc print data=work.onn_scores(obs=5);\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2512  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2513  run;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: There were 5 observations read from the data set WORK.ONN_SCORES.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: PROCEDURE PRINT used (Total process time):\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      real time           0.04 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      cpu time            0.04 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      \",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2514  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2515  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2516  title \\\"Summary statistics for scoring variables\\\";\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2517  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2518  proc means data=work.onn_scores\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2519      n nmiss min p25 median p75 max;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2520  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2521      var commute_score\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2522          housing_afford_score\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2523          income_score\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2524          kids_score\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2525          amenity_score\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2526          travel_time_min\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2527          distance_miles\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2528          median_value\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2529          median_income\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2530          pct_kids_under6\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2531          amenity_count;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2532  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2533  run;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"57                                                         The SAS System                         Monday, April  6, 2026 04:06:00 PM\",\n\t\t\"type\": \"title\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"title\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: There were 716 observations read from the data set WORK.ONN_SCORES.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: PROCEDURE MEANS used (Total process time):\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      real time           0.04 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      cpu time            0.04 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      \",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2534  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2535  title;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2536  ;*';*\\\";*/;run;quit;ods html5(id=vscode) close;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"2537  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t}\n]","mime":"application/vnd.sas.compute.log.lines"}]}]},{"kind":1,"language":"markdown","value":"***\n\n### **Step 4 | Run Scenario-Based Neighborhood Comparisons with PROC OPTMODEL**\n\nNow we are ready to turn our scoring framework into a reusable **scenario-testing tool**.\n\nOur goal is to identify the **Top 10 candidate neighborhoods** based on a weighted combination of priorities such as commute, affordability, family-oriented measures, income, and amenities.\n\nWe use `PROC OPTMODEL` here not because this problem has a single universally “correct” answer, but because it gives us a transparent way to:\n\n- define a neighborhood scoring rule\n- apply practical decision limits\n- compare many neighborhoods at once\n- test how the results change when our priorities change\n\nIn this step, the model includes three main ingredients:\n\n| Component | Meaning in the Model |\n|----------|------------------|\n| **Decision Variable** `x[i]` | 1 if neighborhood is selected |\n| **Objective** | Maximize the total weighted score |\n| **Constraints** | Enforce realistic limits (commute, housing value, number selected) |\n\nBecause we are choosing a fixed number of neighborhoods (`n_choice=10`), maximizing the **total** score is equivalent to maximizing the **average** score among the selected neighborhoods.\n\n### Constraints used in this notebook\n\nWe enforce:\n\n- Exactly **10** neighborhoods selected\n- A maximum allowable **travel time**\n- A maximum allowable **median housing value**\n\nThese constraints help ensure that the recommended neighborhoods reflect both **preferences** and **practical limits**.\n\n***\n\nTo make the process reusable, we wrap the logic in a macro called `RUN_SCENARIO`.\n\nFor each scenario, we will:\n\n1. Start from the scored neighborhood dataset `onn_scores`\n2. Apply a set of **weights** to create a `weighted_score`\n3. Use `PROC OPTMODEL` to select the best set of neighborhoods under the scenario rules\n4. Write the results to a scenario-specific CSV file for later mapping and comparison in Part 3\n\nThe weights represent the relative importance of each factor:\n\n- `w_commute`   → importance of a shorter commute\n- `w_kids`      → importance of family-oriented demographics\n- `w_housing`   → importance of affordability\n- `w_income`    → importance of higher-income neighborhoods\n- `w_amenities` → importance of parks, grocery stores, and bike trails\n\nIn most scenarios, these weights should add up to **1.0**.\n\nThis is important:\n\n> The weights do not emerge from the model.  \n> They come from the decision-maker.\n\nIn other words, the model helps us compare neighborhoods **given our priorities**.  \nIf the priorities change, the recommended neighborhoods may change too.\n\nThat is exactly what makes this a useful decision support exercise.","outputs":[]},{"kind":2,"language":"sas","value":"/*--------------------------------------------------------------*\n | Step 4 | Build a reusable scenario-testing macro\n |\n | For each scenario, we:\n |   1. Compute a weighted neighborhood score\n |   2. Use PROC OPTMODEL to select the best set of neighborhoods\n |   3. Join the chosen neighborhoods back to the full dataset\n |   4. Export the scenario results for use in Part 3\n |\n | Note:\n | The weights reflect household priorities. They should usually\n | add to 1.0 so that the weighted score remains easy to interpret.\n *--------------------------------------------------------------*/\n\n%macro run_scenario(\n    scen_name=,\n    n_choice=,\n    max_travel=,\n    max_value=,\n    w_commute=,\n    w_kids=,\n    w_housing=,\n    w_income=,\n    w_amenities=\n);\n\n    %put NOTE: ===== Running Operation Next Nest scenario &scen_name =====;\n\n    /*----------------------------------------------------------*\n     | Optional check: verify that the weights add to 1.0\n     *----------------------------------------------------------*/\n    %let weight_sum = %sysevalf(\n          &w_commute\n        + &w_kids\n        + &w_housing\n        + &w_income\n        + &w_amenities\n    );\n\n    %put NOTE: Weight sum for scenario &scen_name = &weight_sum;\n\n    /*----------------------------------------------------------*\n     | Step 4a | Compute the weighted score for this scenario\n     |\n     | This score reflects the household priorities defined by\n     | the scenario weights.\n     *----------------------------------------------------------*/\n    data work.onn_scores_&scen_name.;\n        set work.onn_scores;\n\n        weighted_score =\n              &w_commute   * commute_score\n            + &w_kids      * kids_score\n            + &w_housing   * housing_afford_score\n            + &w_income    * income_score\n            + &w_amenities * amenity_score;\n    run;\n\n    /*----------------------------------------------------------*\n     | Step 4b | Use PROC OPTMODEL to select neighborhoods\n     |\n     | Model structure:\n     |   - x[i] = 1 if neighborhood i is selected\n     |   - maximize total weighted score\n     |   - choose exactly n_choice neighborhoods\n     |   - enforce travel time and housing value limits\n     *----------------------------------------------------------*/\n    proc optmodel;\n\n        /* Set of candidate block groups */\n        set BG;\n\n        /* Input data for each candidate */\n        num score{BG};\n        num travel{BG};\n        num value{BG};\n\n        /* Read the scenario-specific scoring data into OPTMODEL */\n        read data work.onn_scores_&scen_name.\n            into BG=[bg_id]\n                 score  = weighted_score\n                 travel = travel_time_min\n                 value  = median_value;\n\n        /* Decision variable: 1 if selected, 0 otherwise */\n        var x{BG} binary;\n\n        /* Objective: maximize total weighted score */\n        max TotalScore = sum {i in BG} score[i] * x[i];\n\n        /* Select exactly n_choice neighborhoods */\n        con ChooseLimit:\n            sum {i in BG} x[i] = &n_choice.;\n\n        /* Enforce a maximum commute time for any chosen neighborhood */\n        con TravelLimit {i in BG}:\n            travel[i] * x[i] <= &max_travel.;\n\n        /* Enforce a maximum housing value for any chosen neighborhood */\n        con ValueLimit {i in BG}:\n            value[i] * x[i] <= &max_value.;\n\n        /* Solve as a mixed-integer linear program */\n        solve with milp;\n\n        /*------------------------------------------------------*\n         | Create a dataset containing only the chosen\n         | neighborhoods for this scenario\n         *------------------------------------------------------*/\n        create data work.onn_choice_&scen_name. from\n            [bg_id] = {i in BG: x[i] > 0.5}\n            chosen_flag = x[i]\n            optmodel_score = score[i]\n            optmodel_travel = travel[i]\n            optmodel_value = value[i];\n    quit;\n\n    /*----------------------------------------------------------*\n     | Step 4c | Join chosen neighborhoods back to the full\n     |          scenario dataset for readable output\n     *----------------------------------------------------------*/\n    proc sql;\n        create table work.onn_result_&scen_name. as\n        select  a.*,\n                b.chosen_flag,\n                b.optmodel_score,\n                b.optmodel_travel,\n                b.optmodel_value\n        from work.onn_scores_&scen_name. as a\n        left join work.onn_choice_&scen_name. as b\n            on a.bg_id = b.bg_id\n        order by weighted_score desc;\n    quit;\n\n    /*----------------------------------------------------------*\n     | Step 4d | Print the chosen neighborhoods\n     |\n     | Show both the weighted score and the original variables\n     | so the results remain interpretable.\n     *----------------------------------------------------------*/\n    title \"Operation Next Nest | Scenario &scen_name | Chosen Neighborhoods\";\n\n    proc print data=work.onn_result_&scen_name.(where=(chosen_flag=1)) noobs;\n        var bg_id\n            GEOID\n            weighted_score\n            travel_time_min\n            distance_miles\n            median_value\n            median_income\n            pct_kids_under6\n            amenity_count\n            has_grocery\n            has_park\n            has_bike;\n    run;\n\n    title;\n\n    /*----------------------------------------------------------*\n     | Step 4e | Export scenario results to CSV for Part 3\n     *----------------------------------------------------------*/\n    proc export data=work.onn_result_&scen_name.\n        outfile=\"&data_path./onn_result_&scen_name..csv\"\n        dbms=csv\n        replace;\n    run;\n\n%mend run_scenario;\n\n\n/*--------------------------------------------------------------*\n | Run the base scenario first (balanced priorities)\n |\n | This scenario gives balanced weight to commute time and\n | family-oriented measures, while still considering housing,\n | income, and amenities.\n *--------------------------------------------------------------*/\n%run_scenario(\n    scen_name=Base,\n    n_choice=10,\n    max_travel=30,\n    max_value=800000,\n    w_commute=0.25,\n    w_kids=0.25,\n    w_housing=0.20,\n    w_income=0.10,\n    w_amenities=0.20\n);","outputs":[{"items":[{"data":"<!DOCTYPE html>\n<html lang=\"en\" xml:lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"SAS V.04.00\" name=\"generator\"/>\n<title>SAS Output</title>\n<style>\n/*<![CDATA[*/\n.body.c > table, .body.c > pre, .body.c div > table,\n.body.c div > pre, .body.c > table, .body.c > pre,\n.body.j > table, .body.j > pre, .body.j div > table,\n.body.j div > pre, .body.j > table, .body.j > pre,\n.body.c p.note, .body.c p.warning, .body.c p.error, .body.c p.fatal,\n.body.j p.note, .body.j p.warning, .body.j p.error, .body.j p.fatal,\n.body.c > table.layoutcontainer, .body.j > table.layoutcontainer { margin-left: auto; margin-right: auto }\n.layoutregion.l table, .layoutregion.l pre, .layoutregion.l p.note,\n.layoutregion.l p.warning, .layoutregion.l p.error, .layoutregion.l p.fatal { margin-left: 0 }\n.layoutregion.c table, .layoutregion.c pre, .layoutregion.c p.note,\n.layoutregion.c p.warning, .layoutregion.c p.error, .layoutregion.c p.fatal { margin-left: auto; margin-right: auto }\n.layoutregion.r table, .layoutregion.r pre, .layoutregion.r p.note,\n.layoutregion.r table, .layoutregion.r pre, .layoutregion.r p.note,\n.layoutregion.r p.warning, .layoutregion.r p.error, .layoutregion.r p.fatal { margin-right: 0 }\narticle, aside, details, figcaption, figure, footer, header, hgroup, nav, section { display: block }\nhtml{ font-size: 100% }\n.body { margin: 1em; font-size: 13px; line-height: 1.231 }\nsup { position: relative; vertical-align: baseline; bottom: 0.25em; font-size: 0.8em }\nsub { position: relative; vertical-align: baseline; top: 0.25em; font-size: 0.8em }\nul, ol { margin: 1em 0; padding: 0 0 0 40px }\ndd { margin: 0 0 0 40px }\nnav ul, nav ol { list-style: none; list-style-image: none; margin: 0; padding: 0 }\nimg { border: 0; vertical-align: middle }\nsvg:not(:root) { overflow: hidden }\nfigure { margin: 0 }\ntable { border-collapse: collapse; border-spacing: 0 }\n.layoutcontainer { border-collapse: separate; border-spacing: 0 }\np { margin-top: 0; text-align: left }\nh1.heading1 { text-align: left }\nh2.heading2 { text-align: left }\nh3.heading3 { text-align: left }\nh4.heading4 { text-align: left }\nh5.heading5 { text-align: left }\nh6.heading6 { text-align: left }\nspan { text-align: left }\ntable { margin-bottom: 1em }\ntd, th { text-align: left; padding: 3px 6px; vertical-align: top }\ntd[class$=\"fixed\"], th[class$=\"fixed\"] { white-space: pre }\nsection, article { padding-top: 1px; padding-bottom: 8px }\nhr.pagebreak { height: 0px; border: 0; border-bottom: 1px solid #c0c0c0; margin: 1em 0 }\n.stacked-value { text-align: left; display: block }\n.stacked-cell > .stacked-value, td.data > td.data, th.data > td.data, th.data > th.data, td.data > th.data, th.header > th.header { border: 0 }\n.stacked-cell > div.data { border-width: 0 }\n.systitleandfootercontainer { white-space: nowrap; margin-bottom: 1em }\n.systitleandfootercontainer > p { margin: 0 }\n.systitleandfootercontainer > p > span { display: inline-block; width: 100%; white-space: normal }\n.batch { display: table }\n.toc { display: none }\n.proc_note_group, .proc_title_group { margin-bottom: 1em }\np.proctitle { margin: 0 }\np.note, p.warning, p.error, p.fatal { display: table }\n.notebanner, .warnbanner, .errorbanner, .fatalbanner,\n.notecontent, .warncontent, .errorcontent, .fatalcontent { display: table-cell; padding: 0.5em }\n.notebanner, .warnbanner, .errorbanner, .fatalbanner { padding-right: 0 }\n.body > div > ol li { text-align: left }\n.beforecaption > h4 { margin-top: 0; margin-bottom: 0 }\n.c { text-align: center }\n.r { text-align: right }\n.l { text-align: left }\n.j { text-align: justify }\n.d { text-align: right }\n.b { vertical-align: bottom }\n.m { vertical-align: middle }\n.t { vertical-align: top }\n.accessiblecaption {\n    background-color: #fafbfe;\n    color: #112277;\n    font-family: 'Anova UI', Arial, 'Albany AMT', Helvetica, Helv;\n    font-size: 11pt;\n    font-style: normal;\n    font-weight: bold;\n}\na:active { color: #800080 }\n.aftercaption {\n    background-color: #fafbfe;\n    border-spacing: 0;\n    color: #112277;\n    font-family: 'Anova UI', Arial, 'Albany AMT', Helvetica, Helv;\n    font-size: 9pt;\n    font-style: normal;\n    font-weight: bold;\n    padding-top: 4pt;\n}\n.batch > colgroup {\n    border-left: 1px solid #c1c1c1;\n    border-right: 1px solid #c1c1c1;\n}\n.batch > tbody, .batch > thead, .batch > tfoot {\n    border-top: 1px solid #c1c1c1;\n    border-bottom: 1px solid #c1c1c1;\n}\n.batch { border: hidden; }\n.batch {\n    background-color: #fafbfe;\n    border: 1px solid #c1c1c1;\n    border-collapse: separate;\n    border-spacing: 1px;\n    color: #000000;\n    font-family: 'SAS Monospace', 'Courier New', Courier, monospace;\n    font-size: 7pt;\n    font-style: normal;\n    font-weight: normal;\n    padding: 7px;\n    }\n.beforecaption {\n    background-color: #fafbfe;\n    border-spacing: 0;\n    color: #112277;\n    font-family: 'Anova UI', Arial, 'Albany AMT', Helvetica, Helv;\n    font-size: 9pt;\n    font-style: normal;\n    font-weight: bold;\n}\n.body {\n    background-color: #fafbfe;\n    color: #000000;\n    font-family: 'Anova UI', Arial, 'Albany AMT', Helvetica, Helv;\n    font-size: 9pt;\n    font-style: normal;\n    font-w