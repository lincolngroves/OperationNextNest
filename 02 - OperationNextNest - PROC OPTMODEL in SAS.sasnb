n\t{\n\t\t\"line\": \"182  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t}\n]","mime":"application/vnd.sas.compute.log.lines"}]}]},{"kind":1,"language":"markdown","value":"***\n\n### Step 2 | Prepare Comparison Variables\n\nThe CSV imported from Part 1 already uses SAS-friendly variable names.\n\nIn this step, we create a smaller set of **clean, readable variables** that will be easier to use in the scoring framework later in the notebook.\n\nSpecifically, we will:\n\n1. Create short aliases for the main neighborhood characteristics we want to compare:\n   - `travel_time_min` → estimated commute time to SAS\n   - `distance_miles` → straight-line distance to the office\n   - `median_value` → median housing value\n   - `median_income` → median household income\n   - `pct_kids_under6` → percentage of households with children under 6\n   - `has_grocery`, `has_park`, `has_bike` → amenity indicators\n\n2. Create a simple `amenity_count` variable that summarizes how many of these three amenities are present nearby\n\n3. Add an integer identifier, `bg_id`, for each block group so that neighborhoods can be indexed more easily in later SAS steps\n\nWe also take care of any invalid placeholder values carried over from the source data so that our later comparisons are based on meaningful neighborhood measures.","outputs":[]},{"kind":2,"language":"sas","value":"data work.operation_next_nest_prep;\n    set work.operation_next_nest_raw;\n\n    /*----------------------------------------------------------*\n     | Create clean aliases for the main variables used in the\n     | neighborhood comparison framework\n     *----------------------------------------------------------*/\n\n    /* Commute and distance */\n    travel_time_min = Travel_Time_to_Office__minutes_;\n    distance_miles  = Distance_to_Office__miles_;\n\n    /* Housing and economic measures */\n    median_value    = Median_Housing_Value;\n    median_income   = Median_Household_Income;\n\n    /* Family-oriented measure */\n    pct_kids_under6 = __Households_with_Children_under;\n\n    /* Amenity flags */\n    has_grocery = has_grocery_store;\n    has_park    = has_park;\n    has_bike    = has_bike_trail;\n\n    /* Convert known placeholder values to missing */\n    if median_value  < 0 then median_value  = .;\n    if median_income < 0 then median_income = .;\n\n    /* Ensure amenity indicators behave like 0/1 flags */\n    has_grocery = (has_grocery = 1);\n    has_park    = (has_park = 1);\n    has_bike    = (has_bike = 1);\n\n    /* Count how many target amenities are present */\n    amenity_count = sum(has_grocery, has_park, has_bike);\n\n    /* Add a simple numeric ID for later indexing */\n    bg_id = _n_;\nrun;\n\n/* Quick summary check */\ntitle \"Summary statistics for prepared neighborhood comparison variables\";\nproc means data=work.operation_next_nest_prep\n    n nmiss min p25 median p75 max;\n    var travel_time_min distance_miles median_value median_income \n        pct_kids_under6 amenity_count;\nrun;\n\ntitle \"First 5 prepared neighborhoods\";\nproc print data=work.operation_next_nest_prep(obs=5);\n    var bg_id travel_time_min distance_miles median_value median_income\n        pct_kids_under6 has_grocery has_park has_bike amenity_count;\nrun;\n\ntitle;","outputs":[{"items":[{"data":"<!DOCTYPE html>\n<html lang=\"en\" xml:lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"SAS V.04.00\" name=\"generator\"/>\n<title>SAS Output</title>\n<style>\n/*<![CDATA[*/\n.body.c > table, .body.c > pre, .body.c div > table,\n.body.c div > pre, .body.c > table, .body.c > pre,\n.body.j > table, .body.j > pre, .body.j div > table,\n.body.j div > pre, .body.j > table, .body.j > pre,\n.body.c p.note, .body.c p.warning, .body.c p.error, .body.c p.fatal,\n.body.j p.note, .body.j p.warning, .body.j p.error, .body.j p.fatal,\n.body.c > table.layoutconta