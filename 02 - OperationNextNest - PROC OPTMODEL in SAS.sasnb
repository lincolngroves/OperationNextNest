ce\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"217      has_grocery = (has_grocery = 1);\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"218      has_park    = (has_park = 1);\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"219      has_bike    = (has_bike = 1);\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"220  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"221      /* Count how many target amenities are present */\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"222      amenity_count = sum(has_grocery, has_park, has_bike);\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"223  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"224      /* Add a simple numeric ID for later indexing */\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"225      bg_id = _n_;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"226  run;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: There were 835 observations read from the data set WORK.OPERATION_NEXT_NEST_RAW.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: The data set WORK.OPERATION_NEXT_NEST_PREP has 835 observations and 52 variables.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: DATA statement used (Total process time):\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      real time           0.00 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      cpu time            0.00 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      \",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"227  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"228  /* Quick summary check */\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"229  title \\\"Summary statistics for prepared neighborhood comparison variables\\\";\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"230  proc means data=work.operation_next_nest_prep\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"231      n nmiss min p25 median p75 max;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"232      var travel_time_min distance_miles median_value median_income\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"233          pct_kids_under6 amenity_count;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"234  run;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: There were 835 observations read from the data set WORK.OPERATION_NEXT_NEST_PREP.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: PROCEDURE MEANS used (Total process time):\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      real time           0.03 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      cpu time            0.04 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      \",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"235  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"236  title \\\"First 5 prepared neighborhoods\\\";\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"237  proc print data=work.operation_next_nest_prep(obs=5);\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"238      var bg_id travel_time_min distance_miles median_value median_income\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"239          pct_kids_under6 has_grocery has_park has_bike amenity_count;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"240  run;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: There were 5 observations read from the data set WORK.OPERATION_NEXT_NEST_PREP.\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: PROCEDURE PRINT used (Total process time):\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      real time           0.01 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      cpu time            0.01 seconds\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"      \",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"241  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"242  title;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"243  ;*';*\\\";*/;run;quit;ods html5(id=vscode) close;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"244  \",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t}\n]","mime":"application/vnd.sas.compute.log.lines"}]}]},{"kind":1,"language":"markdown","value":"***\n\n### Step 3 | Filter Candidates and Build Comparable Scores\n\nBefore comparing neighborhoods, we take two important preparation steps.\n\nFirst, we apply a few basic filters to remove block groups that do not meet our minimum data requirements or fall outside a reasonable commute range.\n\nSecond, we transform several neighborhood measures into **comparable scoring components** that can later be combined into an overall neighborhood score.\n\nThis matters because our variables are measured on very different scales:\n\n- Travel time is measured in minutes\n- Housing value is measured in dollars\n- Median income is measured in dollars\n- Kid-friendliness is measured as a percentage\n- Amenities are summarized as a count\n\nIf we combined those raw variables directly, larger-scale measures would dominate the scoring simply because of their units.\n\nTo avoid that, we convert selected variables to a **0–1 range**, where:\n\n- `1` represents a more favorable value\n- `0` represents a less favorable value\n\nThis transformation preserves the relative ordering of neighborhoods while placing each measure on a comparable scale.\n\nFor example:\n\n- Lower commute time should lead to a higher score\n- Lower housing value should lead to a higher affordability score\n- Higher median income should lead to a higher income score\n- Higher percentages of young children should lead to a higher family-oriented score\n- More nearby amenities should lead to a higher amenity score\n\nThis does **not** mean the standardized values are more interpretable than the original measures.\n\n> Instead, it gives us a practical way to combine very different neighborhood characteristics into a single scoring framework.\n\nWe will continue to keep the original variables as well, so that the final neighborhood recommendations remain easy to interpret.","outputs":[]},{"kind":2,"language":"sas","value":"/*--------------------------------------------------------------*\n | Step 3a | Filter to neighborhoods with usable data and a\n |          reasonable commute range\n |\n | The dataset created in Python contains many block groups,\n | but some may contain missing or invalid values for the\n | variables we plan to use in our scoring framework.\n |\n | We remove observations where:\n |   • required values are missing\n |   • values appear invalid (e.g., <= 0)\n |   • commute time exceeds our practical upper bound\n |\n | The 45-minute threshold is intentionally loose. The goal is\n | simply to remove extreme outliers before we begin comparing\n | neighborhoods more carefully.\n *--------------------------------------------------------------*/\n\ndata work.onn_filtered;\n    set work.operation_next_nest_prep;\n\n    /* Required variables must be present */\n    if missing(travel_time_min) then delete;\n    if missing(median_value) then delete;\n    if missing(median_income) then delete;\n    if missing(pct_kids_under6) then delete;\n\n    /* Remove invalid values */\n    if travel_time_min <= 0 then delete;\n    if median_value <= 0 then delete;\n\n    /* Apply a practical upper bound on commute time */\n    if travel_time_min > 45 then delete;\n\nrun;\n\n\n/*--------------------------------------------------------------*\n | Step 3b | Create standardized versions of selected variables\n |\n | Our neighborhood characteristics are measured on very\n | different scales:\n |\n |   travel_time_min  → minutes\n |   median_value     → dollars\n |   median_income    → dollars\n |   pct_kids_under6  → percent\n |   amenity_count    → count\n |\n | If we combined these raw variables directly, the larger\n | numeric scales would dominate the scoring calculation.\n |\n | To avoid this, we rescale each variable to a 0–1 range using\n | PROC STDIZE with METHOD=RANGE.\n |\n | IMPORTANT:\n | We keep the original variables AND create standardized\n | versions. This allows the final results to remain easy\n | to interpret in their original units.\n *--------------------------------------------------------------*/\n\nproc stdize data=work.onn_filtered\n            out=work.onn_stdized\n            method=range;\n\n    var travel_time_min\n        median_value\n        median_income\n        pct_kids_under6\n        amenity_count;\n\nrun;\n\n\n/*--------------------------------------------------------------*\n | Step 3c | Rename standardized variables\n |\n | PROC STDIZE replaces the variables listed in the VAR\n | statement with their standardized versions.\n |\n | To keep both the original and scaled variables, we rename\n | the standardized values with a \"_std\" suffix.\n *--------------------------------------------------------------*/\n\ndata work.onn_stdized_renamed;\n\n    set work.onn_stdized(\n        keep = bg_id\n               travel_time_min\n               median_value\n               median_income\n               pct_kids_under6\n               amenity_count\n\n        rename = (\n            travel_time_min = travel_time_min_std\n            median_value    = median_value_std\n            median_income   = median_income_std\n            pct_kids_under6 = pct_kids_under6_std\n            amenity_count   = amenity_count_std\n        )\n    );\n\nrun;\n\n\n/*--------------------------------------------------------------*\n | Step 3d | Merge standardized values back with original data\n |\n | This step creates a single dataset containing:\n |\n |   • original variables (for interpretation)\n |   • standardized variables (for scoring)\n |\n | The bg_id variable provides a simple index that allows\n | us to merge the datasets reliably.\n *--------------------------------------------------------------*/\n\nproc sort data=work.onn_filtered;\n    by bg_id;\nrun;\n\nproc sort data=work.onn_stdized_renamed;\n    by bg_id;\nrun;\n\ndata work.onn_scores;\n\n    merge work.onn_filtered\n          work.onn_stdized_renamed;\n\n    by bg_id;\n\nrun;\n\n\n/*--------------------------------------------------------------*\n | Step 3e | Create scoring components\n |\n | We now convert the standardized variables into scoring\n | components where:\n |\n |   Higher value = more desirable neighborhood characteristic\n |\n | Some variables must be direction-corrected:\n |\n |   Lower commute time  → better\n |   Lower housing value → more affordable\n |\n | Other variables already follow the correct direction.\n *--------------------------------------------------------------*/\n\ndata work.onn_scores;\n\n    set work.onn_scores;\n\n    /* Lower commute time is better */\n    commute_score = 1 - travel_time_min_std;\n\n    /* Lower housing value is treated as more affordable */\n    housing_afford_score = 1 - median_value_std;\n\n    /* Higher income is better */\n    income_score = median_income_std;\n\n    /* Higher percentage of young children is better */\n    kids_score = pct_kids_under6_std;\n\n    /* More nearby amenities is better */\n    amenity_score = amenity_count_std;\n\nrun;\n\n\n/*--------------------------------------------------------------*\n | Step 3f | Review the scoring dataset\n |\n | These quick checks help confirm that the scoring components\n | look reasonable before we move into the decision comparison\n | stage using PROC OPTMODEL.\n *--------------------------------------------------------------*/\n\ntitle \"Preview of neighborhoods with scoring components\";\n\nproc print data=work.onn_scores(obs=5);\n\nrun;\n\n\ntitle \"Summary statistics for scoring variables\";\n\nproc means data=work.onn_scores\n    n nmiss min p25 median p75 max;\n\n    var commute_score\n        housing_afford_score\n        income_score\n        kids_score\n        amenity_score\n        travel_time_min\n        distance_miles\n        median_value\n        median_income\n        pct_kids_under6\n        amenity_count;\n\nrun;\n\ntitle;","outputs":[{"items":[{"data":"<!DOCTYPE html>\n<html lang=\"en\" xml:lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n<meta charset=\"utf-8\"/>\n<meta content=\"SAS V.04.00\" name=\"generator\"/>\n<title>SAS Output</title>\n<style>\n/*<![CDATA[*/\n.body.c > table, .body.c > pre, .body.c div > table,\n.body.c div > pre, .body.c > table, .body.c > pre,\n.body.j > table, .body.j > pre, .body.j div > table,\n.body.j div > pre, .body.j > table, .body.j > pre,\n.body.c p.note, .body.c p.warning, .body.c p.error, .body.c p.fatal,\n.body.j p.note, .body.j p.warning, .body.j p.error, .body.j p.fatal,\n.body.c > table.layoutcontainer, .body.j > table.layoutcontainer { margin-left: auto; margin-right: auto }\n.layoutregion.l table, .layoutregion.l pre, .layoutregion.l p.note,\n.layoutregion.l p.warning, .layoutregion.l p.error, .layoutregion.l p.fatal { margin-left: 0 }\n.layoutregion.c table, .layoutregion.c pre, .layoutregion.c p.note,\n.layoutregion.c p.warning, .layoutregion.c p.error, .layoutregion.c p.fatal { margin-left: auto; margin-right: auto }\n.layoutregion.r table, .layoutregion.r pre, .layoutregion.r p.note,\n.layoutregion.r table, .layoutregion.r pre, .layoutregion.r p.note,\n.layoutregion.r p.warning, .layoutregion.r p.error, .layoutregion.r p.fatal { margin-right: 0 }\narticle, aside, details, figcaption, figure, footer, header, hgroup, nav, section { display: block }\nhtml{ font-size: 100% }\n.body { margin: 1em; font-size: 13px; line-height: 1.231 }\nsup { position: relative; vertical-align: baseline; bottom: 0.25em; font-size: 0.8em }\nsub { position: relative; vertical-align: baseline; top: 0.25em; font-size: 0.8em }\nul, ol { margin: 1em 0; padding: 0 0 0 40px }\ndd { margin: 0 0 0 40px }\nnav ul, nav ol { list-style: none; list-style-image: none; margin: 0; padding: 0 }\nimg { border: 0; vertical-align: middle }\nsvg:not(:root) { overflow: hidden }\nfigure { margin: 0 }\ntable { border-collapse: collapse; border-spacing: 0 }\n.layoutcontainer { border-collapse: separate; border-spacing: 0 }\np { margin-top: 0; text-align: left }\nh1.heading1 { text-align: left }\nh2.heading2 { text-align: left }\nh3.heading3 { text-align: left }\nh4.heading4 { text-align: left }\nh5.heading5 { text-align: left }\nh6.heading6 { text-align: left }\nspan { text-align: left }\ntable { margin-bottom: 1em }\ntd, th { text-align: left; padding: 3px 6px; vertical-align: top }\ntd[class$=\"fixed\"], th[class$=\"fixed\"] { white-space: pre }\nsection, article { padding-top: 1px; padding-bottom: 8px }\nhr.pagebreak { height: 0px; border: 0; border-bottom: 1px solid #c0c0c0; margin: 1em 0 }\n.stacked-value { text-align: left; display: block }\n.stacked-cell > .stacked-value, td.data > td.data, th.data > td.data, th.data > th.data, td.data > th.data, th.header > th.header { border: 0 }\n.stacked-cell > div.data { border-width: 0 }\n.systitleandfootercontainer { white-space: nowrap; margin-bottom: 1em }\n.systitleandfootercontainer > p { margin: 0 }\n.systitleandfootercontainer > p > span { display: inline-block; width: 100%; white-space: normal }\n.batch { display: table }\n.toc { display: none }\n.proc_note_group, .proc_title_group { margin-bottom: 1em }\np.proctitle { margin: 0 }\np.note, p.warning, p.error, p.fatal { display: table }\n.notebanner, .warnbanner, .errorbanner, .fatalbanner,\n.notecontent, .warncontent, .errorcontent, .fatalcontent { display: table-cell; padding: 0.5em }\n.notebanner, .warnbanner, .errorbanner, .fatalbanner { padding-right: 0 }\n.body > div > ol li { text-align: left }\n.beforecaption > h4 { margin-top: 0; margin-bottom: 0 }\n.c { text-align: center }\n.r { text-align: right }\n.l { text-align: left }\n.j { text-align: justify }\n.d { text-align: right }\n.b { vertical-align: bottom }\n.m { vertical-align: middle }\n.t { vertical-align: top }\n.accessiblecaption {\n    background-color: #fafbfe;\n    color: #112277;\n    font-family: 'Anova UI', Arial, 'Albany AMT', Helvetica, Helv;\n    font-size: 11pt;\n    font-style: normal;\n    font-weight: bold;\n}\na:active { color: #800080 }\n.aftercaption {\n    background-color: #fafbfe;\n    border-spacing: 0;\n    color: #112277;\n    font-family: 'Anova UI', Arial, 'Albany AMT', Helvetica, Helv;\n    font-size: 9pt;\n    font-style: normal;\n    font-weight: bold;